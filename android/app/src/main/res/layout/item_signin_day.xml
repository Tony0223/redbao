<?xml version="1.0" encoding="utf-8"?>
<!-- 签到格子：金币数和“开/已领”左右排（不再上下叠），下面是第X天 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layout_packet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:background="@drawable/bg_signin_packet"
        android:gravity="center_vertical"
        android:minWidth="72dp"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="10dp"
        android:paddingRight="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tv_signin_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFF6D8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_signin_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="开"
            android:textColor="#FFD54F"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_signin_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#666666"
        android:textSize="12sp" />
</LinearLayout>

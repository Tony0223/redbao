<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layout_packet"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:background="@drawable/bg_signin_packet"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_signin_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFF6D8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_signin_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="开"
            android:textColor="#FFD54F"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_signin_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#666666"
        android:textSize="12sp" />
</LinearLayout>
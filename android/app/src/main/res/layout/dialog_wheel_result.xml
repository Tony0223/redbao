<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_wheel_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="22dp"
    android:paddingTop="26dp"
    android:paddingRight="22dp"
    android:paddingBottom="22dp">

    <TextView
        android:id="@+id/tv_wheel_result_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="恭喜中奖"
        android:textColor="#222222"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_wheel_result_coins"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="0 金币"
        android:textColor="#E8261F"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_wheel_result_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="金币已到账\n可在福利页查看今日收益"
        android:textColor="#888888"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btn_wheel_ok"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_wheel_btn"
        android:gravity="center"
        android:text="开心收下"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />
</LinearLayout>

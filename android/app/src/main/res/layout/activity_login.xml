<?xml version="1.0" encoding="utf-8"?>
<!-- 登录页：APP 启动入口，未登录时展示，登录成功后进首页 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="120dp"
        android:src="@drawable/ic_app_jinshisudi" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/app_name"
        android:textColor="#333333"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="登录后开始领红包赚金币"
        android:textColor="#999999"
        android:textSize="14sp" />

    <!-- 占位，把登录按钮推到下方 -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 邀请码(选填)：从剪贴板识别到会自动填上，也可以手动输入代理/好友给的邀请码 -->
    <EditText
        android:id="@+id/et_invite_code"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_white_card"
        android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
        android:gravity="center"
        android:hint="邀请码（选填）"
        android:inputType="textCapCharacters"
        android:maxLength="16"
        android:singleLine="true"
        android:textColor="#333333"
        android:textColorHint="#BBBBBB"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/btn_wechat_login"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:background="@drawable/bg_wechat_login_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_wechat_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="微信登录"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="36dp"
        android:text="登录即代表同意《用户协议》和《隐私政策》"
        android:textColor="#AAAAAA"
        android:textSize="11sp" />
</LinearLayout>

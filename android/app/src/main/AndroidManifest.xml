<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      targetSdk 30+ 的包可见性限制：App 默认查不到别的 App 装没装。
      微信 SDK 的 isWXAppInstalled() 要能查到微信包，否则会误判"未安装微信"导致登录失败。
      这段声明了需要查询的外部 App，缺了它微信登录/分享/支付在高 targetSdk 下都会出问题。
    -->
    <queries>
        <!-- 微信：登录、分享、支付授权 -->
        <package android:name="com.tencent.mm" />
        <!-- 打开网页：检查更新跳下载链接、邀请落地页等 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RedPacketApp">
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SplashActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".wxapi.WXEntryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name="com.tonyfeng.jinshisuda.activity.WithdrawalActivity" />
        <activity android:name="com.tonyfeng.jinshisuda.activity.InviteListActivity" />
        <activity android:name="com.tonyfeng.jinshisuda.activity.PunchActivity" />
        <activity android:name="com.tonyfeng.jinshisuda.activity.BonusActivity" />
        <activity android:name="com.tonyfeng.jinshisuda.activity.WheelActivity" />
        <activity android:name="com.tonyfeng.jinshisuda.activity.IncomeActivity" />
        <activity android:name="com.tonyfeng.jinshisuda.activity.SettingsActivity" />
        <activity android:name="com.tonyfeng.jinshisuda.activity.ContentActivity" />
        <activity android:name="com.tonyfeng.jinshisuda.activity.FeedbackActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
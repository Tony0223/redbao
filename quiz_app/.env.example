# 请使用高强度、互不相同的密码；不要把真实 .env 提交到 Git。
MYSQL_ROOT_PASSWORD=replace_with_a_long_random_root_password
MYSQL_DATABASE=quiz_app
MYSQL_USER=quiz_app
MYSQL_PASSWORD=replace_with_a_long_random_app_password

APP_TIMEZONE=Asia/Shanghai
MYSQL_HOST_PORT=3306

# API 使用独立域名，例如 api.example.com，不要填写 http:// 或 https://。
API_DOMAIN=api.example.com
CERTBOT_EMAIL=admin@example.com

# 原生 APP 通常不受浏览器 CORS 限制。若还提供 H5，可填写允许的域名，多个域名用逗号分隔。
CORS_ORIGINS=*
